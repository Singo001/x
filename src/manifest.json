{
  "manifest_version": 3,
  "name": "Ordklar – skriv med ro",
  "version": "1.0.0",
  "description": "Lokal dansk og engelsk stavekontrol, enkle grammatikregler og din egen ordliste. Ingen tekst sendes til en server.",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Ordklar", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "options_page": "options.html",
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle", "all_frames": true, "match_about_blank": true }]
}
